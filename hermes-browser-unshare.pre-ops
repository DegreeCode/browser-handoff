#!/bin/bash
set -euo pipefail

STATE=/run/hermes-browser
PIDFILE="$STATE/quick-tunnel.pid"

if [[ -f "$PIDFILE" ]]; then
  PID="$(cat "$PIDFILE" 2>/dev/null || true)"

  if [[ "$PID" =~ ^[0-9]+$ ]] && kill -0 "$PID" 2>/dev/null; then
    kill "$PID" 2>/dev/null || true
    for _ in {1..20}; do
      kill -0 "$PID" 2>/dev/null || break
      sleep 0.1
    done
  fi
fi

rm -f \
  "$STATE/quick-tunnel.pid" \
  "$STATE/quick-tunnel.url" \
  "$STATE/quick-tunnel.log"

echo "Browser handoff closed"
