#!/bin/bash
set -euo pipefail

source /usr/local/lib/hermes-browser/common.sh

exec 9>/run/hermes-browser.lock
if ! flock -w 30 9; then
  hb_log ERROR "action=stop error=lock_timeout"
  echo "Could not acquire browser lifecycle lock" >&2
  exit 1
fi

hb_log INFO "action=stop phase=cleanup"

# Quick Tunnel만 정확한 PID로 종료.
STATE="/run/hermes-browser"
PIDFILE="$STATE/quick-tunnel.pid"

if [[ -f "$PIDFILE" ]]; then
  PID="$(cat "$PIDFILE" 2>/dev/null || true)"

  if [[ "$PID" =~ ^[0-9]+$ ]] && kill -0 "$PID" 2>/dev/null; then
    kill "$PID" 2>/dev/null || true

    for _ in {1..30}; do
      kill -0 "$PID" 2>/dev/null || break
      sleep 0.1
    done

    kill -KILL "$PID" 2>/dev/null || true
  fi
fi

docker rm -f hermes-browser >/dev/null 2>&1 || true
rm -rf "$STATE"

hb_log INFO "action=stop result=stopped"
echo "Hermes browser stopped"
